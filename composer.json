{
	"name": "artem23334/vistula-travel",
	"description": "Vistula Travel — WordPress theme (vistula-travel) + plugin (vistula-core). One runtime dependency: Secure Custom Fields (TD-12), installed as a WordPress plugin via WPackagist.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
	"require": {
		"php": ">=8.2",
		"composer/installers": "^2.3",
		"wpackagist-plugin/secure-custom-fields": "*"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.4.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"extra": {
		"installer-paths": {
			"wp-content/plugins/{$name}/": [
				"type:wordpress-plugin"
			]
		}
	},
	"scripts": {
		"lint": "find wp-content -name '*.php' -print0 | xargs -0 -n1 php -l",
		"cs": "phpcs",
		"cs-fix": "phpcbf"
	}
}
