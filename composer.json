{
	"name": "artem23334/vistula-travel",
	"description": "Vistula Travel — WordPress theme (vistula-travel) + plugin (vistula-core). Dev tooling only; this project has no runtime PHP dependencies.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.4.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "find wp-content -name '*.php' -print0 | xargs -0 -n1 php -l",
		"cs": "phpcs",
		"cs-fix": "phpcbf"
	}
}
